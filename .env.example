# The same Neon database the frontend uses. The checkpointer writes its own
# tables here (see `pnpm db:setup`); everything else it reads is the app's.
DATABASE_URL=

# The chain of models, tried in order until one answers. There is no built-in
# fallback: what runs is what is named here and nothing else, because a model
# id is a tier, a price and a quota bucket, and one shipped in a release months
# ago is a choice nobody made. Without one the service reports itself
# not_configured on /health rather than failing a question at a time.
#
# More than one is still worth having — quota is counted per model, so being
# out of the free bucket on the cheap one leaves the others.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# GEMINI_MODEL is the same thing with one entry, for a deploy that wants one.
GEMINI_MODEL=

# A second key is a second allowance, not a spare: quota is counted per project.
# GEMINI_API_KEYS adds to GEMINI_API_KEY rather than replacing it.
GEMINI_API_KEY=
GEMINI_API_KEYS=

# How much reaches the console: debug | info | warn | error | silent.
# Default info — one access line per request, plus warnings and failures. debug
# adds a line per model call (which model, whose key). warn drops the access
# lines when they are only noise. An unreadable value falls back to info rather
# than refusing to boot. silent stops the console, not the Telegram alerts.
LOG_LEVEL=

# Shared secret the frontend sends as `Authorization: Bearer <token>`. Until the
# frontend is wired up this is also how you call the API by hand.
SERVICE_TOKEN=

# Where a crash is announced — the same bot and chat the frontend reports into,
# so one place shows both services. Absent, nothing is sent and errors stay in
# the console. Set these on the deploy, not locally, or every typo buzzes you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
