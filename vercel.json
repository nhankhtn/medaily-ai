{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "buildCommand": "tsc --noEmit",
  "outputDirectory": "public",
  "build": {
    "env": {
      "NODEJS_HELPERS": "0"
    }
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
